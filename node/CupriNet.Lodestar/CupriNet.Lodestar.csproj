<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A headless overlay ("keep the network alive") node. No UI, no L2 — Concordance only. -->
    <AssemblyName>cuprinet-lodestar</AssemblyName>
    <RootNamespace>CupriNet.Lodestar</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <!-- QR rendering for the optional status page. PngByteQRCode is pure-managed (no System.Drawing),
         so it works in the headless dotnet/runtime container. The HTTP server itself uses the BCL's
         HttpListener — no ASP.NET Core / heavy web stack. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately NO reference to CupriNet.Arcanum / CupriNet.Rites: a Lodestar structurally cannot
         hold a channel (L2). It only runs the L1 Concordance overlay and routes metadata about L2. -->
    <ProjectReference Include="..\..\src\CupriNet.Hosting\CupriNet.Hosting.csproj" />
    <ProjectReference Include="..\..\src\CupriNet.Core\CupriNet.Core.csproj" />
    <ProjectReference Include="..\..\src\CupriNet.Persistence\CupriNet.Persistence.csproj" />
    <ProjectReference Include="..\..\src\CupriNet.Alembic.BouncyCastle\CupriNet.Alembic.BouncyCastle.csproj" />
    <!-- Optional Tor transport (managed CupriTor, from the Wixely feed). A Lodestar can run onion-only,
         keeping the network alive anonymously; enabled at runtime with EnableTor. -->
    <ProjectReference Include="..\..\src\CupriNet.Tor\CupriNet.Tor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
