<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional Tor transport: a concrete IOnionTransport backed by the CupriTor package. Kept a SEPARATE
    project so the core stays dependency-free of Tor: anyone who wants Tor references this project (or
    the CupriNet.Tor package - it is packed and pushed to the feed alongside CupriNet.WebRtc, so a
    downstream can offer an onion transport without transcribing this binding); everyone else ignores it.

    The binding is compile-verified against CupriTor 0.1.5 (the latest release). Building it needs the
    Wixely GitHub Packages feed (see /nuget.config) + a read:packages token - which the whole build
    already needs for CupriMark, so this project no longer carries an extra requirement.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CupriNet.Hosting\CupriNet.Hosting.csproj" />
    <ProjectReference Include="..\CupriNet.Vessel\CupriNet.Vessel.csproj" />
    <ProjectReference Include="..\CupriNet.Abstractions\CupriNet.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CupriTor" Version="0.1.5" />
  </ItemGroup>

</Project>
