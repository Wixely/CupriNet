{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CupriChatLite",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cuprichatlite",
      "program": "${workspaceFolder}/samples/CupriChatLite/bin/Debug/net10.0/CupriChatLite.dll",
      "cwd": "${workspaceFolder}/samples/CupriChatLite",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": { "CUPRICHATLITE_HOME": "${workspaceFolder}/samples/CupriChatLite/.data/a" }
    },
    {
      "name": "CupriChatLite (2nd instance)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cuprichatlite",
      "program": "${workspaceFolder}/samples/CupriChatLite/bin/Debug/net10.0/CupriChatLite.dll",
      "cwd": "${workspaceFolder}/samples/CupriChatLite",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": { "CUPRICHATLITE_HOME": "${workspaceFolder}/samples/CupriChatLite/.data/b" }
    },
    {
      "name": "CupriChatLite (3rd instance)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cuprichatlite",
      "program": "${workspaceFolder}/samples/CupriChatLite/bin/Debug/net10.0/CupriChatLite.dll",
      "cwd": "${workspaceFolder}/samples/CupriChatLite",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": { "CUPRICHATLITE_HOME": "${workspaceFolder}/samples/CupriChatLite/.data/c" }
    },
    {
      "name": "Lodestar (clearnet + web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-lodestar",
      "program": "${workspaceFolder}/node/CupriNet.Lodestar/bin/Debug/net10.0/cuprinet-lodestar.dll",
      "cwd": "${workspaceFolder}/node/CupriNet.Lodestar",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "CUPRINET_LODESTAR_Concordium": "debug.local",
        "CUPRINET_LODESTAR_EnableWeb": "true",
        "CUPRINET_LODESTAR_WebListenAddress": "127.0.0.1",
        "CUPRINET_LODESTAR_WebPort": "8080",
        "CUPRINET_LODESTAR_DataDirectory": "${workspaceFolder}/node/CupriNet.Lodestar/.debug-data"
      },
      // Open the status page in the browser once the web server logs its URL. serverReadyAction watches the
      // Debug Console output (hence console: internalConsole above) for the "Status page serving on <url>" line.
      "serverReadyAction": {
        "pattern": "Status page serving on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Lodestar (Tor + web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-lodestar",
      "program": "${workspaceFolder}/node/CupriNet.Lodestar/bin/Debug/net10.0/cuprinet-lodestar.dll",
      "cwd": "${workspaceFolder}/node/CupriNet.Lodestar",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "CUPRINET_LODESTAR_Concordium": "debug.local",
        "CUPRINET_LODESTAR_EnableTor": "true",
        "CUPRINET_LODESTAR_EnableWeb": "true",
        "CUPRINET_LODESTAR_WebListenAddress": "127.0.0.1",
        "CUPRINET_LODESTAR_WebPort": "8081",
        "CUPRINET_LODESTAR_DataDirectory": "${workspaceFolder}/node/CupriNet.Lodestar/.debug-data-tor"
      },
      // Same as the clearnet config: auto-open the clearnet-face status page when it starts serving.
      "serverReadyAction": {
        "pattern": "Status page serving on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "CupriChatLite x2",
      "configurations": ["CupriChatLite", "CupriChatLite (2nd instance)"],
      "stopAll": true
    },
    {
      "name": "CupriChatLite x3",
      "configurations": ["CupriChatLite", "CupriChatLite (2nd instance)", "CupriChatLite (3rd instance)"],
      "stopAll": true
    }
  ]
}
