<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the Wixely GitHub Packages feed so the CupriTor package can be restored.
  No secret is stored here: set the credentials via environment variables before restoring —
      GITHUB_ACTOR = your GitHub username
      GITHUB_TOKEN = a Personal Access Token with the `read:packages` scope
  (On CI these are provided automatically.)
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="wixely-github" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <wixely-github>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </wixely-github>
  </packageSourceCredentials>
</configuration>
