<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the Wixely GitHub Packages feed so the CupriTor package can be restored.
  Credentials are NOT stored here; they come from your NuGet credential configuration:
  a user-level NuGet.Config credential for the "GitHub-Wixely" source (a PAT with the
  read:packages scope), or a token injected by CI at build time.
  There is no clear element here, so nuget.org and any user/machine sources still apply.
-->
<configuration>
  <packageSources>
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
</configuration>
